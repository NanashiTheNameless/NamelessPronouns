<p class="easter-status" role="status" aria-live="polite" popover="manual" data-easter-status></p>
<noscript><p class="warning" role="status">No script? No problem. You are still a person.</p></noscript>
<dialog class="accessibility-panel" aria-labelledby="accessibility-h" data-accessibility-panel>
  <h2 id="accessibility-h">Accessibility</h2>
  <p class="fineprint">These settings are kept in this browser only. They are never sent to the server and are not part of your account.</p>
  <form method="dialog">
    <fieldset>
      <legend>Theme</legend>
      <label class="choice"><input type="radio" name="accessibility_theme" value="default" checked><span>Site default (dark)</span></label>
      <label class="choice"><input type="radio" name="accessibility_theme" value="light"><span>Light</span></label>
      <label class="choice"><input type="radio" name="accessibility_theme" value="contrast"><span>High contrast, dark</span></label>
      <label class="choice"><input type="radio" name="accessibility_theme" value="contrast-light"><span>High contrast, light</span></label>
      <label class="choice" data-konami-theme hidden><input type="radio" name="accessibility_theme" value="1998"><span>1998</span></label>
      <label class="choice"><input type="radio" name="accessibility_theme" value="custom"><span>Arbitrary theme, your own colors</span></label>
    </fieldset>
    <fieldset data-accessibility-colors hidden>
      <legend>Your colors</legend>
      <p class="fineprint">Each one takes an HTML color code such as <code>#1a2b3c</code>. Leave a box empty to keep the site default for it.</p>
      <div class="accessibility-colors">
        <label for="accessibility-color-bg">Page background
          <span class="accessibility-color-row"><input type="color" data-color-picker="bg" aria-label="Pick the page background"><input id="accessibility-color-bg" name="accessibility_color_bg" type="text" inputmode="text" maxlength="7" pattern="#[0-9A-Fa-f]{6}" autocomplete="off" spellcheck="false" data-color-label="The page background" placeholder="The color behind the whole page"></span>
        </label>
        <label for="accessibility-color-surface">Panels and entry fields
          <span class="accessibility-color-row"><input type="color" data-color-picker="surface" aria-label="Pick the panel and field color"><input id="accessibility-color-surface" name="accessibility_color_surface" type="text" maxlength="7" pattern="#[0-9A-Fa-f]{6}" autocomplete="off" spellcheck="false" data-color-label="The panel color" placeholder="The color of cards, panels, and text boxes"></span>
        </label>
        <label for="accessibility-color-text">Body text
          <span class="accessibility-color-row"><input type="color" data-color-picker="text" aria-label="Pick the body text color"><input id="accessibility-color-text" name="accessibility_color_text" type="text" maxlength="7" pattern="#[0-9A-Fa-f]{6}" autocomplete="off" spellcheck="false" data-color-label="The body text color" placeholder="The color of ordinary reading text"></span>
        </label>
        <label for="accessibility-color-muted">Secondary text
          <span class="accessibility-color-row"><input type="color" data-color-picker="muted" aria-label="Pick the secondary text color"><input id="accessibility-color-muted" name="accessibility_color_muted" type="text" maxlength="7" pattern="#[0-9A-Fa-f]{6}" autocomplete="off" spellcheck="false" data-color-label="The secondary text color" placeholder="The color of hints and small print"></span>
        </label>
        <label for="accessibility-color-border">Borders
          <span class="accessibility-color-row"><input type="color" data-color-picker="border" aria-label="Pick the border color"><input id="accessibility-color-border" name="accessibility_color_border" type="text" maxlength="7" pattern="#[0-9A-Fa-f]{6}" autocomplete="off" spellcheck="false" data-color-label="The border color" placeholder="The outline around fields and panels"></span>
        </label>
        <label for="accessibility-color-accent">Buttons and highlights
          <span class="accessibility-color-row"><input type="color" data-color-picker="accent" aria-label="Pick the button color"><input id="accessibility-color-accent" name="accessibility_color_accent" type="text" maxlength="7" pattern="#[0-9A-Fa-f]{6}" autocomplete="off" spellcheck="false" data-color-label="The button color" placeholder="The fill behind primary buttons"></span>
        </label>
        <label for="accessibility-color-accentText">Text on buttons
          <span class="accessibility-color-row"><input type="color" data-color-picker="accentText" aria-label="Pick the button label color"><input id="accessibility-color-accentText" name="accessibility_color_accentText" type="text" maxlength="7" pattern="#[0-9A-Fa-f]{6}" autocomplete="off" spellcheck="false" data-color-label="The button label color" placeholder="The lettering shown on primary buttons"></span>
        </label>
        <label for="accessibility-color-link">Links in profile text
          <span class="accessibility-color-row"><input type="color" data-color-picker="link" aria-label="Pick the profile link color"><input id="accessibility-color-link" name="accessibility_color_link" type="text" maxlength="7" pattern="#[0-9A-Fa-f]{6}" autocomplete="off" spellcheck="false" data-color-label="The link color" placeholder="The color of links inside a profile bio"></span>
        </label>
        <label for="accessibility-color-focus">Keyboard focus ring
          <span class="accessibility-color-row"><input type="color" data-color-picker="focus" aria-label="Pick the focus ring color"><input id="accessibility-color-focus" name="accessibility_color_focus" type="text" maxlength="7" pattern="#[0-9A-Fa-f]{6}" autocomplete="off" spellcheck="false" data-color-label="The focus ring color" placeholder="The outline that follows keyboard focus"></span>
        </label>
        <label for="accessibility-color-placeholder">Placeholder text
          <span class="accessibility-color-row"><input type="color" data-color-picker="placeholder" aria-label="Pick the placeholder color"><input id="accessibility-color-placeholder" name="accessibility_color_placeholder" type="text" maxlength="7" pattern="#[0-9A-Fa-f]{6}" autocomplete="off" spellcheck="false" data-color-label="The placeholder color" placeholder="The color of the hint inside an empty field"></span>
        </label>
      </div>
      <p class="fineprint" role="status" aria-live="polite" data-accessibility-contrast></p>
    </fieldset>
    <fieldset>
      <legend>Text font</legend>
      <label class="choice"><input type="radio" name="accessibility_font" value="default" checked><span>Site default (0xProto)</span></label>
      <label class="choice"><input type="radio" name="accessibility_font" value="sans"><span>Your system sans-serif font</span></label>
      <label class="choice"><input type="radio" name="accessibility_font" value="serif"><span>Your system serif font</span></label>
      <label class="choice"><input type="radio" name="accessibility_font" value="mono"><span>Your system monospace font</span></label>
      <label class="choice"><input type="radio" name="accessibility_font" value="custom"><span>Arbitrary font family, named by you</span></label>
    </fieldset>
    <div data-accessibility-family hidden>
      <label for="accessibility-font-family">Font family
        <input id="accessibility-font-family" name="accessibility_font_family" type="text" maxlength="120" autocomplete="off" spellcheck="false" placeholder="The name of a font installed on your device, with fallbacks after commas">
      </label>
      <p class="fineprint">Only fonts already on your device can be used. Nothing is downloaded, so a name your device does not have falls back to the site font.</p>
    </div>
    <fieldset>
      <legend>Copy or paste your settings</legend>
      <label for="accessibility-transfer">Settings text
        <textarea id="accessibility-transfer" rows="6" spellcheck="false" data-accessibility-transfer placeholder="Your current settings appear here, ready to copy into another browser"></textarea>
      </label>
      <div class="inline-actions">
        <button type="button" class="secondary" data-accessibility-copy>Copy settings</button>
        <button type="button" class="secondary" data-accessibility-import>Apply pasted settings</button>
      </div>
    </fieldset>
    <p class="fineprint" role="status" aria-live="polite" data-accessibility-status></p>
    <div class="inline-actions">
      <button type="button" class="secondary" data-accessibility-reset>Reset to defaults</button>
      <button type="button" data-accessibility-close>Done</button>
    </div>
  </form>
</dialog>
<dialog class="accessibility-panel shortcuts-panel" aria-labelledby="shortcuts-h" data-shortcuts-panel>
  <h2 id="shortcuts-h">Keyboard shortcuts</h2>
  <dl class="details shortcuts-list">
    <div><dt><kbd>Tab</kbd></dt><dd>Move to the next link or control</dd></div>
    <div><dt><kbd>Shift</kbd> + <kbd>Tab</kbd></dt><dd>Move to the previous link or control</dd></div>
    <div><dt><kbd>Enter</kbd></dt><dd>Activate the focused link or button</dd></div>
    <div><dt><kbd>Space</kbd></dt><dd>Activate or toggle the focused control</dd></div>
    <div><dt><kbd>Arrow keys</kbd></dt><dd>Move through options in a radio group</dd></div>
    <div><dt><kbd>Shift</kbd> + <kbd>?</kbd></dt><dd>Open this list</dd></div>
    <div><dt><kbd>Escape</kbd></dt><dd>Close an open panel</dd></div>
    <div><dt>Konami code</dt><dd><kbd>Up</kbd> <kbd>Up</kbd> <kbd>Down</kbd> <kbd>Down</kbd> <kbd>Left</kbd> <kbd>Right</kbd> <kbd>Left</kbd> <kbd>Right</kbd> <kbd>B</kbd> <kbd>A</kbd></dd></div>
  </dl>
  <button type="button" data-shortcuts-close>Done</button>
</dialog>
