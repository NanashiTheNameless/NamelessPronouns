<!DOCTYPE html>
<html lang="en">
<head><%- await include('partials/head', { title }) %></head>
<body>
  <%- await include('partials/site-header') %>
  <main class="container">
    <div class="profile-heading">
      <img class="avatar avatar-large" src="<%= avatar %>" alt="" width="96" height="96">
      <div><h1><%= profile.display_name %></h1>
    <p class="username">@<%= username %></p>
      </div>
    </div>
    <% if (profile.description) { %><p><%- await obfuscateEmails(profile.description) %></p><% } %>

    <% if (flags.length) { %>
      <section class="identity-flags-section" aria-labelledby="flags-h">
        <h2 id="flags-h">Flags</h2>
        <ul class="identity-flags">
          <% flags.forEach(function (flag) { %><li><img src="<%= flag.imageUrl %>" alt="" width="48" height="32" loading="lazy"><span><%= flag.label %></span><span class="opinion"><%= flag.opinion %></span></li><% }); %>
        </ul>
      </section>
    <% } %>

    <% if (names.length) { %>
      <section aria-labelledby="names-h">
        <h2 id="names-h">Names</h2>
        <ul class="opinion-list"><% names.forEach(function (n) { %><li><span><%= n.value %></span><span class="opinion"><%= n.opinion %></span></li><% }); %></ul>
      </section>
    <% } %>

    <% if (pronouns.length) { %>
      <section aria-labelledby="pronouns-h">
        <h2 id="pronouns-h">Pronouns</h2>
        <ul class="opinion-list">
        <% pronouns.forEach(function (p) { %>
          <li>
            <span class="pronoun-set"><%= p.subject %>/<%= p.object %>/<%= p.possessive_determiner %>/<%= p.possessive_pronoun %>/<%= p.reflexive %></span>
            <span class="opinion"><%= p.opinion %></span>
          </li>
        <% }); %>
        </ul>
      </section>
    <% } %>

    <% if (pronounPreferences.length) { %>
      <section aria-labelledby="pronoun-preferences-h">
        <h2 id="pronoun-preferences-h">Pronoun preferences</h2>
        <ul class="opinion-list"><% pronounPreferences.forEach(function (preference) { %><li><span><%= preference.label %></span><span class="opinion"><%= preference.opinion %></span></li><% }); %></ul>
      </section>
    <% } %>

    <% if (words.length) { %>
      <section class="word-groups" aria-labelledby="words-h">
        <h2 id="words-h">Words</h2>
        <% words.forEach(function (group, gi) { %>
          <section class="word-group" aria-labelledby="word-group-<%= gi %>">
            <h3 id="word-group-<%= gi %>"><%= group.heading %></h3>
            <ul class="opinion-list"><% group.words.forEach(function (word) { %><li><span><%= word.value %></span><span class="opinion"><%= word.opinion %></span></li><% }); %></ul>
          </section>
        <% }); %>
      </section>
    <% } %>

    <% if (profile.notes) { %>
      <section aria-labelledby="notes-h">
        <h2 id="notes-h">Notes</h2>
        <p><%- await obfuscateEmails(profile.notes) %></p>
      </section>
    <% } %>

    <% if (links.length) { %>
      <section aria-labelledby="links-h">
        <h2 id="links-h">Links</h2>
        <ul>
        <% links.forEach(function (l) { %>
          <li><a href="<%= l.url %>" rel="noopener noreferrer nofollow"><%= l.label %></a></li>
        <% }); %>
        </ul>
      </section>
    <% } %>
  </main>
  <%- await include('partials/site-footer') %>
</body>
</html>
