<!DOCTYPE html>
<html lang="en">
<head><%- await include('../partials/head', { title }) %></head>
<body>
  <%- await include('../partials/site-header') %>
  <main class="container">
    <p class="eyebrow">Administrator tools</p>
    <h1>Content exemptions</h1>
    <p>Exact values and their hashes are deliberately not displayed here.</p>
    <% if (exemptions.length === 0) { %><p>No active exemptions.</p><% } %>
    <% for (const item of exemptions) { %>
      <section class="panel stack">
        <h2><%= item.rule_id %>, version <%= item.version %></h2>
        <p>Field <%= item.field_type %>; account <% if (item.email) { %><%- await obfuscateEmail(item.email) %><% } else { %>none<% } %>; profile scope <%= item.profile_id || 'all account profiles' %>; <%= item.self_exemption ? 'self exemption' : 'review exemption' %>.</p>
        <p>Created <%= item.createdAt %>. Expires <%= item.expiresAt || 'never' %>.</p>
        <form method="post" action="/admin/content-exemptions/<%= item.id %>" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>New expiry
            <select name="expiry"><option value="7">7 days from now</option><option value="30">30 days</option><option value="90">90 days</option><option value="none">No expiry</option></select>
          </label>
          <label>Reason <input name="reason" maxlength="200" required></label>
          <label>Type UPDATE EXEMPTION <input name="confirmation" autocomplete="off" required></label>
          <button type="submit" name="action" value="expiry">Update expiry</button>
        </form>
        <form method="post" action="/admin/content-exemptions/<%= item.id %>" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Revocation reason <input name="reason" maxlength="200" required></label>
          <label>Type REVOKE EXEMPTION <input name="confirmation" autocomplete="off" required></label>
          <button type="submit" name="action" value="revoke" class="danger">Revoke exemption</button>
        </form>
      </section>
    <% } %>
    <p><a href="/admin/content-rules">Back to content rules</a></p>
  </main>
  <%- await include('../partials/site-footer') %>
</body>
</html>
