<!DOCTYPE html>
<html lang="en">
<head><%- await include('partials/head', { title }) %></head>
<body>
  <%- await include('partials/site-header') %>
  <main class="container">
    <% if (locals.preview === 'owner') { %>
      <p class="warning" role="status">Only you can see this page: this profile is yours and it is not published.
        <a href="/profiles/<%= profile.id %>/edit">Edit or publish it</a>.</p>
    <% } else if (locals.preview === 'staff') { %>
      <p class="warning" role="status">You can see this page because you are staff. This profile is not published, so nobody else can see it.</p>
    <% } %>
    <div class="profile-heading" data-profile-page data-profile-username="<%= username %>">
      <button type="button" class="profile-avatar-button" data-profile-avatar aria-label="Inspect profile avatar">
        <img class="avatar avatar-large" src="<%= avatar %>" alt="" width="96" height="96">
      </button>
      <div><h1<% if (locals.ownerEgg) { %> data-owner-heading<% } %>><%= profile.display_name %></h1>
    <p class="username">@<%= username %><% if (locals.staffBadge) { %>
      <span class="staff-badge-wrap"><span class="status-badge staff-badge" tabindex="0" aria-describedby="staff-badge-description"<% if (locals.ownerEgg) { %> data-owner-badge<% } %>><%= locals.staffBadge %><% if (locals.staffBadgeHidden) { %> [Status: Hidden]<% } %></span><span class="staff-badge-description" id="staff-badge-description" role="tooltip"><%= locals.staffBadgeLine %><% if (locals.staffBadgeHidden) { %> This badge is hidden from everyone who is not staff.<% } %></span></span><% } %></p>
      </div>
    </div>
    <% if (locals.descriptionHtml) { %><div class="profile-prose profile-bio"><%- locals.descriptionHtml %></div><% } %>

    <% if (flags.length) { %>
      <section class="identity-flags-section" aria-labelledby="flags-h">
        <h2 id="flags-h">Flags</h2>
        <ul class="identity-flags">
          <% flags.forEach(function (flag) { %><li><img src="<%= flag.imageUrl %>" alt="" width="48" height="32" loading="lazy"><span><%= flag.label %></span></li><% }); %>
        </ul>
        <% if (flags.length >= 11) { %><p class="fineprint flag-collector">Collector.</p><% } %>
      </section>
    <% } %>

    <% if (names.length) { %>
      <section aria-labelledby="names-h">
        <h2 id="names-h">Names</h2>
        <ul class="opinion-list"><% for (const n of names) { %><li><%- await include('partials/opinion', { opinion: n.opinion }) %><span class="opinion-value"><%= n.value %></span></li><% } %></ul>
      </section>
    <% } %>

    <% if (pronouns.length) { %>
      <section aria-labelledby="pronouns-h">
        <h2 id="pronouns-h">Pronouns</h2>
        <ul class="opinion-list">
        <% for (const p of pronouns) { %>
          <li>
            <%- await include('partials/opinion', { opinion: p.opinion }) %>
            <span class="pronoun-set opinion-value"><%= p.short || `${p.subject}/${p.object}/${p.possessive_determiner}/${p.possessive_pronoun}/${p.reflexive}` %></span>
          </li>
        <% } %>
        </ul>
        <% if (locals.pronounOpinionEgg) { %><p class="fineprint pronoun-opinion-egg"><%= locals.pronounOpinionEgg %></p><% } %>
      </section>
    <% } %>

    <% if (pronounPreferences.length) { %>
      <section aria-labelledby="pronoun-preferences-h">
        <h2 id="pronoun-preferences-h">Pronoun preferences</h2>
        <ul class="opinion-list"><% for (const preference of pronounPreferences) { %><li><%- await include('partials/opinion', { opinion: preference.opinion }) %><span class="opinion-value"><%= preference.label %></span></li><% } %></ul>
      </section>
    <% } %>

    <% if (words.length) { %>
      <section class="word-groups" aria-labelledby="words-h">
        <h2 id="words-h">Words</h2>
        <% for (const [gi, group] of words.entries()) { %>
          <section class="word-group" aria-labelledby="word-group-<%= gi %>">
            <h3 id="word-group-<%= gi %>"><%= group.heading %></h3>
            <ul class="opinion-list"><% for (const word of group.words) { %><li><%- await include('partials/opinion', { opinion: word.opinion }) %><span class="opinion-value"><%= word.value %></span></li><% } %></ul>
          </section>
        <% } %>
      </section>
    <% } %>

    <% if (locals.notesHtml) { %>
      <section aria-labelledby="notes-h">
        <h2 id="notes-h">Notes</h2>
        <div class="profile-prose"><%- locals.notesHtml %></div>
      </section>
    <% } %>

    <% if (links.length) { %>
      <section aria-labelledby="links-h">
        <h2 id="links-h">Links</h2>
        <ul>
        <% links.forEach(function (l) { %>
          <li><a href="<%= l.url %>" rel="noopener noreferrer nofollow"><%= l.label %></a></li>
        <% }); %>
        </ul>
      </section>
    <% } %>
    <p class="print-easter-egg">This profile escaped the internet.</p>
    <% if (locals.ownerEgg) { %><p class="print-easter-egg">Approved for escape by NamelessNanashi.</p><% } %>
    <% if (username === 'nobody') { %><p class="print-easter-egg">Nobody printed this.</p><% } %>
  </main>
  <%- await include('partials/site-footer') %>
</body>
</html>
