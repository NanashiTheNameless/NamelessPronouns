<!DOCTYPE html>
<html lang="en">
<head><%- await include('partials/head', { title }) %></head>
<body>
  <%- await include('partials/site-header') %>
  <main class="container">
    <p class="eyebrow">Your account</p>
    <h1>Dashboard</h1>
    <p class="lede">Signed in as <%- await obfuscateEmail(user.email) %>.</p>
    <section aria-labelledby="profiles-h">
      <h2 id="profiles-h">Profiles</h2>
      <p class="fineprint">Using <%= profiles.length %> of <%= profileLimit %> profile<%= profileLimit === 1 ? '' : 's' %>.</p>
      <% if (profiles.length === 0) { %>
        <p>No profiles are available. Yet.</p>
      <% } else { %>
        <ul>
          <% profiles.forEach(function (profile) { %>
            <li class="profile-card">
              <strong><%= profile.display_name %></strong><% if (Number(profile.is_primary) === 1) { %> <span class="status-badge">Primary</span><% } %>
              <p class="fineprint">/u/<%= profile.username %></p>
              <div class="inline-actions">
                <a class="button secondary compact" href="/profiles/<%= profile.id %>/edit" aria-label="Edit <%= profile.username %>">Edit</a>
                <% if (Number(profile.published) === 1) { %>
                  <a class="button secondary compact" href="/u/<%= profile.username %>" aria-label="View the public page for <%= profile.username %>">View public page</a>
                <% } else { %>
                  <a class="button secondary compact" href="/u/<%= profile.username %>" aria-label="Preview the unpublished page for <%= profile.username %>">Preview page</a>
                  <span class="status-badge">Unpublished</span>
                <% } %>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>
    <div class="actions">
      <% if (profiles.length < profileLimit) { %>
        <a class="button" href="/profiles/new">Create another profile</a>
      <% } %>
      <a class="button secondary" href="/settings">Account settings</a>
    </div>
  </main>
  <%- await include('partials/site-footer') %>
</body>
</html>
