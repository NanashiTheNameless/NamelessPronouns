<!DOCTYPE html>
<html lang="en">
<head><%- await include('../partials/head', { title }) %></head>
<body>
  <%- await include('../partials/site-header') %>
  <main class="container">
    <p class="eyebrow">Account</p>
    <h1>Content flags</h1>
    <p>Profile edits that matched enforcing content rules appear here. Attempted values are not displayed on this page.</p>

    <% if (flags.length === 0) { %>
      <p>No content flags.</p>
    <% } else { %>
      <% flags.forEach(function (flag) { %>
        <section class="panel stack">
          <h2><%= flag.policy_category %></h2>
          <dl class="details">
            <div><dt>Affected field</dt><dd><%= contentFieldLabel(flag.field_type) %></dd></div>
            <div><dt>Severity</dt><dd><%= flag.severity %></dd></div>
            <div><dt>Flag status</dt><dd><%= flag.status %></dd></div>
            <div><dt>Created</dt><dd><%= flag.createdAt %></dd></div>
            <% if (flag.review_status) { %><div><dt>Review status</dt><dd><%= flag.review_status %></dd></div><% } %>
          </dl>
          <% if (flag.status === 'pending' && !flag.review_status) { %>
            <form method="post" action="/account/content-flags/<%= flag.id %>/review">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label>Why is this flag incorrect?
                <textarea name="explanation" maxlength="500" required placeholder="Why this flag is wrong, and what the text actually means"></textarea>
              </label>
              <button type="submit">Request Administrator review</button>
            </form>
          <% } %>
        </section>
      <% }); %>
    <% } %>
    <p><a href="/settings">Back to settings</a></p>
  </main>
  <%- await include('../partials/site-footer') %>
</body>
</html>

