<!DOCTYPE html>
<html lang="en">
<head><%- await include('partials/head', { title }) %></head>
<body>
  <%- await include('partials/site-header') %>
  <main class="container">
    <p class="eyebrow">Profile editor</p>
    <h1>Edit <%= profile.username %></h1>
    <div class="inline-actions">
      <a class="button secondary compact" href="/dashboard">Back to dashboard</a>
      <a class="button secondary compact" href="#profile-icon">Edit profile icon</a>
    </div>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <% if (warning) { %><p class="error" role="alert"><%= warning %> <a href="/account/content-flags">Review content flags</a>.</p><% } %>
    <% if (saved) { %><p role="status">Profile saved.</p><% } %>
    <% if (importNotice) { %><p class="success" role="status"><%= importNotice %></p><% } %>

    <form method="post" action="/profiles/<%= profile.id %>/edit">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="_save_id" value="<%= saveId %>">

      <label>Display name
        <input name="display_name" maxlength="80" pattern="[A-Za-z0-9 \-]+" data-character-constraint data-character-hint="Use only letters, numbers, spaces, and dashes." required value="<%= values.displayName %>" placeholder="The name shown at the top of your profile">
      </label>
      <div class="prose-field">
        <label for="description">About me
          <textarea id="description" name="description" aria-describedby="description-characters description-hint" class="tall" rows="14" maxlength="<%= markdown.max %>" data-character-constraint data-character-set="[\x20-\x7E\n]" data-character-hint="Use only standard English letters, numbers, punctuation, and spaces." placeholder="A few sentences about you. **Bold**, *italics*, and headings work here."><%= values.description %></textarea>
        </label>
        <p class="error" id="description-characters" role="status" aria-live="polite" data-character-report></p>
        <p class="fineprint" id="description-hint">A bio in your own words: who you are, what you do, anything you want visitors to read first. Up to <%= markdown.max %> characters.</p>
        <%- await include('partials/markdown-help', { markdown }) %>
      </div>
      <div class="prose-field">
        <label for="notes">Identity notes
          <textarea id="notes" name="notes" aria-describedby="notes-characters notes-hint" rows="10" maxlength="<%= markdown.max %>" data-character-constraint data-character-set="[\x20-\x7E\n]" data-character-hint="Use only standard English letters, numbers, punctuation, and spaces." placeholder="Anything else visitors should know about your names, pronouns, or words"><%= values.notes %></textarea>
        </label>
        <p class="error" id="notes-characters" role="status" aria-live="polite" data-character-report></p>
        <p class="fineprint" id="notes-hint">Extra context about your names, pronouns, or words. Up to <%= markdown.max %> characters.</p>
        <%- await include('partials/markdown-help', { markdown }) %>
      </div>

      <fieldset data-repeater>
        <legend>Names</legend>
        <div data-repeater-rows class="repeat-rows">
          <% for (const [i, name] of values.names.entries()) { %>
            <section data-repeater-row data-row-label="Name" class="repeat-row" aria-label="Name <%= i + 1 %>">
              <label><span data-row-heading>Name <%= i + 1 %></span><input name="name" maxlength="80" pattern="[A-Za-z0-9 \-]+" data-character-constraint data-character-hint="Use only letters, numbers, spaces, and dashes." value="<%= name.value %>" placeholder="A name you go by"></label>
              <%- await include('partials/opinion-select', { name: 'name_opinion', selected: name.opinion, opinionOptions }) %>
              <button type="button" class="secondary compact" data-remove>Remove</button>
            </section>
          <% } %>
        </div>
        <button type="button" class="secondary add-row" data-add>Add another name</button>
        <template><section data-repeater-row data-row-label="Name" class="repeat-row"><label><span data-row-heading>Name</span><input name="name" maxlength="80" pattern="[A-Za-z0-9 \-]+" data-character-constraint data-character-hint="Use only letters, numbers, spaces, and dashes." placeholder="A name you go by"></label><%- await include('partials/opinion-select', { name: 'name_opinion', selected: '', opinionOptions }) %><button type="button" class="secondary compact" data-remove>Remove</button></section></template>
      </fieldset>

      <fieldset data-repeater>
        <legend>Pronoun sets</legend>
        <div data-repeater-rows class="repeat-rows">
          <% for (const [i, row] of values.pronouns.entries()) { %>
            <section data-repeater-row data-row-label="Set" class="repeat-row repeat-row-group" aria-label="Pronoun set <%= i + 1 %>">
              <h2 data-row-heading>Set <%= i + 1 %></h2>
              <div class="pronoun-preset">
                <label>Optional preset <select data-pronoun-preset><option value="">Choose a preset</option><% pronounPresetOptions.forEach(function (preset) { %><option value="<%= preset.key %>" data-subject="<%= preset.forms[0] %>" data-object="<%= preset.forms[1] %>" data-possessive-determiner="<%= preset.forms[2] %>" data-possessive-pronoun="<%= preset.forms[3] %>" data-reflexive="<%= preset.forms[4] %>"><%= preset.label %></option><% }); %></select></label>
                <button type="button" class="secondary compact" data-apply-pronoun-preset>Use preset</button>
              </div>
              <label>Subject <input name="subject" maxlength="40" pattern="[A-Za-z0-9\/'\-]+" data-character-constraint data-character-hint="Use only letters, numbers, slashes, apostrophes, and dashes." value="<%= row.subject %>" placeholder="Subject form, used before the verb"></label>
              <label>Object <input name="object" maxlength="40" pattern="[A-Za-z0-9\/'\-]+" data-character-constraint data-character-hint="Use only letters, numbers, slashes, apostrophes, and dashes." value="<%= row.object %>" placeholder="Object form, used after the verb"></label>
              <label>Possessive determiner <input name="possessive_determiner" maxlength="40" pattern="[A-Za-z0-9\/'\-]+" data-character-constraint data-character-hint="Use only letters, numbers, slashes, apostrophes, and dashes." value="<%= row.possessiveDeterminer %>" placeholder="Possessive form used before a noun"></label>
              <label>Possessive pronoun <input name="possessive_pronoun" maxlength="40" pattern="[A-Za-z0-9\/'\-]+" data-character-constraint data-character-hint="Use only letters, numbers, slashes, apostrophes, and dashes." value="<%= row.possessivePronoun %>" placeholder="Possessive form used on its own"></label>
              <label>Reflexive <input name="reflexive" maxlength="40" pattern="[A-Za-z0-9\/'\-]+" data-character-constraint data-character-hint="Use only letters, numbers, slashes, apostrophes, and dashes." value="<%= row.reflexive %>" placeholder="Reflexive form, used to refer back to you"></label>
              <%- await include('partials/opinion-select', { name: 'pronoun_opinion', selected: row.opinion, opinionOptions }) %>
              <button type="button" class="secondary compact" data-remove>Remove</button>
            </section>
          <% } %>
        </div>
        <button type="button" class="secondary add-row" data-add>Add another pronoun set</button>
        <template><section data-repeater-row data-row-label="Set" class="repeat-row repeat-row-group"><h2 data-row-heading>Set</h2><div class="pronoun-preset"><label>Optional preset <select data-pronoun-preset><option value="">Choose a preset</option><% pronounPresetOptions.forEach(function (preset) { %><option value="<%= preset.key %>" data-subject="<%= preset.forms[0] %>" data-object="<%= preset.forms[1] %>" data-possessive-determiner="<%= preset.forms[2] %>" data-possessive-pronoun="<%= preset.forms[3] %>" data-reflexive="<%= preset.forms[4] %>"><%= preset.label %></option><% }); %></select></label><button type="button" class="secondary compact" data-apply-pronoun-preset>Use preset</button></div><label>Subject <input name="subject" maxlength="40" pattern="[A-Za-z0-9\/'\-]+" data-character-constraint data-character-hint="Use only letters, numbers, slashes, apostrophes, and dashes." placeholder="Subject form, used before the verb"></label><label>Object <input name="object" maxlength="40" pattern="[A-Za-z0-9\/'\-]+" data-character-constraint data-character-hint="Use only letters, numbers, slashes, apostrophes, and dashes." placeholder="Object form, used after the verb"></label><label>Possessive determiner <input name="possessive_determiner" maxlength="40" pattern="[A-Za-z0-9\/'\-]+" data-character-constraint data-character-hint="Use only letters, numbers, slashes, apostrophes, and dashes." placeholder="Possessive form used before a noun"></label><label>Possessive pronoun <input name="possessive_pronoun" maxlength="40" pattern="[A-Za-z0-9\/'\-]+" data-character-constraint data-character-hint="Use only letters, numbers, slashes, apostrophes, and dashes." placeholder="Possessive form used on its own"></label><label>Reflexive <input name="reflexive" maxlength="40" pattern="[A-Za-z0-9\/'\-]+" data-character-constraint data-character-hint="Use only letters, numbers, slashes, apostrophes, and dashes." placeholder="Reflexive form, used to refer back to you"></label><%- await include('partials/opinion-select', { name: 'pronoun_opinion', selected: '', opinionOptions }) %><button type="button" class="secondary compact" data-remove>Remove</button></section></template>
      </fieldset>

      <fieldset>
        <legend>Pronoun preferences</legend>
        <p class="fineprint">Leave a preference on "Not listed" to keep it off your profile.</p>
        <div class="choice-grid">
          <% for (const preference of pronounPreferenceOptions) { %>
            <% const chosen = (values.pronounPreferences || []).find(function (entry) { return entry.key === preference.key; }); %>
            <div class="choice choice-opinion">
              <span><%= preference.label %></span>
              <%- await include('partials/opinion-select', { name: 'pronoun_pref_' + preference.key, selected: chosen ? chosen.opinion : '', opinionOptions, optional: true, legend: 'How you feel about it' }) %>
            </div>
          <% } %>
        </div>
      </fieldset>

      <fieldset data-repeater data-word-groups>
        <legend>Words</legend>
        <p class="fineprint">Group words the way Pronouns.page does: give each group a heading, then list the words that belong under it.</p>
        <div data-repeater-rows class="repeat-rows">
          <% for (const [gi, group] of values.words.entries()) { %>
            <section data-repeater-row data-word-group data-row-label="Word group" class="repeat-row repeat-row-group" aria-label="Word group <%= gi + 1 %>">
              <h2 data-row-heading>Word group <%= gi + 1 %></h2>
              <label>Heading <input name="word_group_heading" maxlength="80" pattern="[\x20-\x7E]*" data-character-constraint data-character-hint="Use only standard English letters, numbers, punctuation, and spaces." value="<%= group.heading %>" placeholder="What the words in this group have in common"></label>
              <fieldset data-repeater class="word-rows">
                <legend>Words in this group</legend>
                <div data-repeater-rows class="repeat-rows">
                  <% for (const [wi, word] of group.words.entries()) { %>
                    <section data-repeater-row data-row-label="Word" class="repeat-row" aria-label="Word <%= wi + 1 %>">
                      <label><span data-row-heading>Word <%= wi + 1 %></span><input name="word_value_<%= gi %>" maxlength="80" pattern="[\x20-\x7E]*" data-character-constraint data-character-hint="Use only standard English letters, numbers, punctuation, and spaces." value="<%= word.value %>" placeholder="A word that belongs in this group"></label>
                      <%- await include('partials/opinion-select', { name: 'word_opinion_' + gi, selected: word.opinion, opinionOptions }) %>
                      <button type="button" class="secondary compact" data-remove>Remove</button>
                    </section>
                  <% } %>
                </div>
                <button type="button" class="secondary add-row" data-add>Add another word</button>
                <template><section data-repeater-row data-row-label="Word" class="repeat-row"><label><span data-row-heading>Word</span><input name="word_value_<%= gi %>" maxlength="80" pattern="[\x20-\x7E]*" data-character-constraint data-character-hint="Use only standard English letters, numbers, punctuation, and spaces." placeholder="A word that belongs in this group"></label><%- await include('partials/opinion-select', { name: 'word_opinion_' + gi, selected: '', opinionOptions }) %><button type="button" class="secondary compact" data-remove>Remove</button></section></template>
              </fieldset>
              <button type="button" class="secondary compact" data-remove>Remove this group</button>
            </section>
          <% } %>
        </div>
        <button type="button" class="secondary add-row" data-add>Add another word group</button>
        <template><section data-repeater-row data-word-group data-row-label="Word group" class="repeat-row repeat-row-group"><h2 data-row-heading>Word group</h2><label>Heading <input name="word_group_heading" maxlength="80" pattern="[\x20-\x7E]*" data-character-constraint data-character-hint="Use only standard English letters, numbers, punctuation, and spaces." placeholder="What the words in this group have in common"></label><fieldset data-repeater class="word-rows"><legend>Words in this group</legend><div data-repeater-rows class="repeat-rows"><section data-repeater-row data-row-label="Word" class="repeat-row"><label><span data-row-heading>Word</span><input name="word_value_0" maxlength="80" pattern="[\x20-\x7E]*" data-character-constraint data-character-hint="Use only standard English letters, numbers, punctuation, and spaces." placeholder="A word that belongs in this group"></label><%- await include('partials/opinion-select', { name: 'word_opinion_0', selected: '', opinionOptions }) %><button type="button" class="secondary compact" data-remove>Remove</button></section></div><button type="button" class="secondary add-row" data-add>Add another word</button><template><section data-repeater-row data-row-label="Word" class="repeat-row"><label><span data-row-heading>Word</span><input name="word_value_0" maxlength="80" pattern="[\x20-\x7E]*" data-character-constraint data-character-hint="Use only standard English letters, numbers, punctuation, and spaces." placeholder="A word that belongs in this group"></label><%- await include('partials/opinion-select', { name: 'word_opinion_0', selected: '', opinionOptions }) %><button type="button" class="secondary compact" data-remove>Remove</button></section></template></fieldset><button type="button" class="secondary compact" data-remove>Remove this group</button></section></template>
      </fieldset>

      <fieldset data-repeater>
        <legend>Links</legend>
        <div data-repeater-rows class="repeat-rows">
          <% values.links.forEach(function (row, i) { %>
            <section data-repeater-row data-row-label="Link" class="repeat-row repeat-row-group" aria-label="Link <%= i + 1 %>">
              <h2 data-row-heading>Link <%= i + 1 %></h2>
              <label>Label <input name="link_label" maxlength="80" pattern="[A-Za-z0-9 \-]+" data-character-constraint data-character-hint="Use only letters, numbers, spaces, and dashes." value="<%= row.label %>" placeholder="The text shown for this link"></label>
              <label>HTTPS URL <input name="link_url" type="url" pattern="https://.*" maxlength="2048" data-character-constraint data-character-hint="Enter an HTTPS URL that starts with https://." value="<%= row.url %>" placeholder="The full HTTPS address of the page"></label>
              <button type="button" class="secondary compact" data-remove>Remove</button>
            </section>
          <% }); %>
        </div>
        <button type="button" class="secondary add-row" data-add>Add another link</button>
        <template><section data-repeater-row data-row-label="Link" class="repeat-row repeat-row-group"><h2 data-row-heading>Link</h2><label>Label <input name="link_label" maxlength="80" pattern="[A-Za-z0-9 \-]+" data-character-constraint data-character-hint="Use only letters, numbers, spaces, and dashes." placeholder="The text shown for this link"></label><label>HTTPS URL <input name="link_url" type="url" pattern="https://.*" maxlength="2048" data-character-constraint data-character-hint="Enter an HTTPS URL that starts with https://." placeholder="The full HTTPS address of the page"></label><button type="button" class="secondary compact" data-remove>Remove</button></section></template>
      </fieldset>

      <fieldset data-repeater>
        <legend>Flags</legend>
        <p class="fineprint">Choose a built-in Pronouns.page flag.</p>
        <div data-repeater-rows class="repeat-rows">
          <% for (const [i, flag] of values.flags.entries()) { %>
            <section data-repeater-row data-row-label="Flag" class="repeat-row" aria-label="Flag <%= i + 1 %>">
              <%- await include('partials/flag-picker', { selected: flag, heading: 'Flag ' + (i + 1), flagOptions }) %>
              <button type="button" class="secondary compact" data-remove>Remove</button>
            </section>
          <% } %>
        </div>
        <button type="button" class="secondary add-row" data-add>Add another flag</button>
        <template><section data-repeater-row data-row-label="Flag" class="repeat-row"><%- await include('partials/flag-picker', { selected: '', heading: 'Flag', flagOptions }) %><button type="button" class="secondary compact" data-remove>Remove</button></section></template>
      </fieldset>

      <div class="form-actions">
        <label class="choice"><input type="checkbox" name="published" <%= values.published ? 'checked' : '' %>><span>Publish this profile</span></label>
        <button type="submit">Save profile</button>
      </div>
    </form>

    <% if (isPrimary) { %>
      <p class="fineprint">This is the primary profile of the account. It heads the dashboard and cannot be deleted. Contact support if you need the role moved to another profile.</p>
    <% } else { %>
      <p class="fineprint">The primary profile heads the dashboard and cannot be deleted. Only one profile holds that role at a time, and it is moved on request: contact support if you need this profile to hold it.</p>
    <% } %>
    <% if (canDelete) { %>
      <section class="panel stack" aria-labelledby="delete-profile-h">
        <h2 id="delete-profile-h">Delete this profile</h2>
        <p>Removes <%= profile.username %> and everything on it: names, pronouns, words, links, and flags. This cannot be undone.</p>
        <p class="fineprint">The username stays reserved to this account for <%= usernameHoldDays %> days, then anyone may claim it.</p>
        <form method="post" action="/profiles/<%= profile.id %>/delete" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Type <%= profile.username %> exactly, capital letters included <input name="confirmation" autocomplete="off" autocapitalize="off" spellcheck="false" required placeholder="<%= profile.username %>"></label>
          <button type="submit" class="danger">Delete profile</button>
        </form>
      </section>
    <% } %>

    <section class="panel import-panel" aria-labelledby="import-h">
      <h2 id="import-h">Import from Pronouns.page</h2>
      <p>Enter a username, <code>u/username</code> path, or profile URL. You can review the imported values before saving.</p>
      <form method="post" action="/profiles/<%= profile.id %>/import/pronouns-page" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Pronouns.page profile
          <input name="pronouns_page_profile" maxlength="300" required placeholder="A Pronouns.page username or profile URL to copy fields from">
        </label>
        <button type="submit" class="secondary">Import for review</button>
      </form>
    </section>
    <% if (isStaff) { %>
      <section class="panel stack" id="staff-badge" aria-labelledby="staff-badge-h">
        <h2 id="staff-badge-h">Staff badge</h2>
        <p>This profile shows your <%= staffBadgeLabel %> badge to visitors. Hiding it removes the badge from the page entirely for everyone who is not staff, not just from view.</p>
        <p class="fineprint">Other staff still see the badge, marked [Status: Hidden]. Each profile is set separately.</p>
        <form method="post" action="/profiles/<%= profile.id %>/staff-badge" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="choice"><input type="checkbox" name="staff_badge_hidden" <%= staffBadgeHidden ? 'checked' : '' %>><span>Hide my staff badge on this profile</span></label>
          <button type="submit" class="secondary">Save badge visibility</button>
        </form>
      </section>
    <% } %>

    <section class="panel stack" id="profile-icon" aria-labelledby="profile-icon-h">
      <h2 id="profile-icon-h">Profile icon</h2>
      <p class="fineprint">This icon is used for <%= profile.username %> only. Leave it on the account default to follow the icon set in account settings.</p>
      <img id="avatar-preview" class="avatar avatar-large" src="<%= avatar %>" alt="Profile icon preview" width="96" height="96">
      <form method="post" action="/profiles/<%= profile.id %>/avatar" id="avatar-form" class="stack" data-max-bytes="<%= maxAvatarBytes %>" data-current-source="<%= avatarSource %>" data-identicon="<%= identiconAvatar %>" data-gravatar="<%= gravatarAvatar %>" data-libravatar="<%= libravatarAvatar %>" data-inherit="<%= accountAvatar %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label><input type="radio" name="avatar_source" value="inherit" <%= avatarSource === 'inherit' ? 'checked' : '' %>> The account default set in <a href="/settings#profile-icon">account settings</a></label>
        <label><input type="radio" name="avatar_source" value="identicon" <%= avatarSource === 'identicon' ? 'checked' : '' %>> Deterministic identicon for this profile</label>
        <label><input type="radio" name="avatar_source" value="gravatar" <%= avatarSource === 'gravatar' ? 'checked' : '' %>> Gravatar for the verified email</label>
        <label><input type="radio" name="avatar_source" value="libravatar" <%= avatarSource === 'libravatar' ? 'checked' : '' %>> Libravatar for the verified email</label>
        <label><input type="radio" name="avatar_source" value="data" <%= avatarSource === 'data' ? 'checked' : '' %>> Uploaded image stored as a small data URI</label>
        <label>Choose image
          <input id="avatar-file" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml">
        </label>
        <input id="avatar-data-uri" type="hidden" name="avatar_data_uri" value="">
        <p id="avatar-size" aria-live="polite">Select a raster image to resize and compress, or a safe SVG icon to sanitize, entirely in this browser.</p>
        <p id="avatar-error" class="error" role="alert" hidden></p>
        <button id="avatar-strip-svg" type="button" hidden>Strip disallowed SVG content</button>
        <button id="avatar-save" type="submit">Save profile icon</button>
      </form>
    </section>

  </main>
  <%- await include('partials/site-footer') %>
  <script src="/static/js/profile-editor.js"></script>
  <script src="/static/js/avatar-upload.js"></script>
</body>
</html>
