<header class="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    <a class="brand" href="/">NamelessPronouns</a>
    <div class="nav-links">
      <% if (typeof user !== 'undefined' && user) { %>
        <% if (typeof deletionRequest === 'undefined' || !deletionRequest) { %>
          <a class="button secondary compact" href="/dashboard">Dashboard</a>
          <a class="button secondary compact" href="/settings">Settings</a>
          <% if (['support', 'moderator', 'administrator', 'owner'].includes(user.staff_role)) { %>
            <a class="button secondary compact" href="/admin">Admin</a>
          <% } %>
        <% } %>
        <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
          <form class="nav-logout" method="post" action="/logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="secondary compact">Sign out</button>
          </form>
        <% } %>
      <% } else { %>
        <a class="button secondary compact" href="/login">Sign in</a>
        <a class="button compact" href="/signup">Request account</a>
      <% } %>
    </div>
  </nav>
</header>
