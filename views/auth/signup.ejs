<!DOCTYPE html>
<html lang="en">
<head><%- await include('../partials/head', { title }) %></head>
<body>
  <%- await include('../partials/site-header') %>
  <main class="container">
    <p class="eyebrow">Restricted signup</p>
    <h1>Request an account</h1>
    <p>New accounts are reviewed before activation. You will verify your email next.</p>
    <% if (error) { %><p role="alert" class="error"><%= error %></p><% } %>
    <form method="post" action="/signup" data-common-password-check>
      <p><label for="email">Email</label><br>
        <input id="email" name="email" type="email" autocomplete="email" required value="<%= values.email || '' %>" placeholder="The address you will verify and sign in with"></p>
      <p><label for="password">Password (12 to 256 characters)</label><br>
        <input id="password" name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="256" placeholder="At least 12 characters, and not a known leaked password"></p>
      <p class="error" role="alert" data-common-password-message></p>
      <p><label for="profile_username">Profile username (3 to 32 characters, a to z, A to Z, 0 to 9, and hyphens)</label><br>
        <input id="profile_username" name="profile_username" required value="<%= values.profile_username || '' %>" placeholder="The name in your profile address: letters, numbers, and single hyphens between them"></p>
      <p><label for="display_name">Display name</label><br>
        <input id="display_name" name="display_name" required value="<%= values.display_name || '' %>" placeholder="The name shown on your profile, which you can change later"></p>
      <p><label for="reason">Why do you want an account? (20 to 5000 characters)</label><br>
        <textarea id="reason" name="reason" rows="10" minlength="20" maxlength="5000" required placeholder="Who invited you, or what you want to use a profile here for"><%= values.reason || '' %></textarea></p>
      <label class="choice"><input type="checkbox" name="policies" required><span>I agree to the <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a>.</span></label>
      <label class="choice"><input type="checkbox" name="age18" required><span>I confirm that I am at least 18 years old.</span></label>
      <%- await include('../partials/altcha-field', { altchaEndpoint: 'signup' }) %>
      <button type="submit">Request account</button>
    </form>
    <p><a href="/login">Already have an account? Sign in.</a></p>
  </main>
  <%- await include('../partials/site-footer') %>
  <script src="/static/js/common-password.js"></script>
</body>
</html>
