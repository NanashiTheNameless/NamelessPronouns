<!DOCTYPE html>
<html lang="en">
<head><%- await include('../partials/head', { title }) %></head>
<body>
  <%- await include('../partials/site-header') %>
  <main class="container">
    <p class="eyebrow">Staff tools</p>
    <h1>Administration</h1>
    <% if (typeof user !== 'undefined' && user && user.staff_role === 'owner') { %>
      <p>Welcome back. Everything is somehow still running.</p>
    <% } %>
    <nav class="admin-tools-grid" aria-label="Administration tools">
        <a class="button secondary" href="/admin/easter-eggs">Easter egg catalog</a>
        <% if (canReport) { %><a class="button secondary" href="/admin/reports">Operational reports</a><% } %>
        <% if (canApprove) { %>
          <a class="button secondary" href="/admin/signups">Review signup requests</a>
          <a class="button secondary" href="/admin/content-flags">Review content flags</a>
          <a class="button secondary" href="/admin/users">User directory</a>
          <a class="button secondary" href="/admin/suspensions">Review content suspensions</a>
          <a class="button secondary" href="/admin/content-rules">Manage content rules</a>
          <a class="button secondary" href="/admin/recovery">Review recovery cases</a>
          <a class="button secondary" href="/admin/legal-holds">Manage legal holds</a>
          <a class="button secondary" href="/admin/bans">Manage bans</a>
          <a class="button secondary" href="/admin/email-rules">Manage email-domain rules</a>
          <a class="button secondary" href="/admin/password-resets">Force password resets</a>
          <a class="button secondary" href="/admin/audit">Browse audit log</a>
        <% } %>
    </nav>

    <section aria-labelledby="lookup-h">
      <h2 id="lookup-h">Account lookup (exact email)</h2>
      <form method="get" action="/admin">
        <input name="email" type="text" inputmode="email" value="<%= email %>" aria-label="Email" placeholder="The exact address on the account">
        <button type="submit">Search</button>
      </form>
      <% if (locals.lookupMessage) { %><p><%= locals.lookupMessage %></p>
      <% } else if (email && !searched) { %><p>No account with that exact email.</p><% } %>
      <% if (searched) { %>
        <p><%- await obfuscateEmail(searched.email) %> | <%= searched.signup_status %>, role <%= searched.staff_role %>, 2FA <%= searched.twofa_method %>. <a href="/admin/accounts/<%= searched.id %>">Open account</a></p>
      <% } %>
    </section>

    <section aria-labelledby="pending-h">
      <h2 id="pending-h">Pending approvals</h2>
      <% if (pending.length === 0) { %>
        <p>No pending requests.</p>
      <% } else { %>
        <ul>
        <% for (const u of pending) { %>
          <li>
            <strong><%= u.requested_display_name %></strong> (@<%= u.requested_profile_username %>) | <%- await obfuscateEmail(u.email) %>
            | <%= u.email_verified_at ? 'email verified' : 'email unverified' %>
            <% if (canApprove) { %><a href="/admin/signups">Review request</a><% } %>
          </li>
        <% } %>
        </ul>
        <% if (canApprove) { %><p><a href="/admin/signups">Open the signup request queue</a> to read each applicant's reason before deciding.</p><% } %>
      <% } %>
    </section>
  </main>
  <%- await include('../partials/site-footer') %>
</body>
</html>
