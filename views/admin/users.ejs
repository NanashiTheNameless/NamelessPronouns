<!DOCTYPE html>
<html lang="en">
<head><%- await include('../partials/head', { title }) %></head>
<body>
  <%- await include('../partials/site-header') %>
  <main class="container">
    <p class="eyebrow">Administrator tools</p>
    <h1>User directory</h1>
    <p><%= total %> account<%= total === 1 ? '' : 's' %>.</p>
    <% if (users.length === 0) { %>
      <p>No accounts.</p>
    <% } else { %>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Account</th><th>Rank</th><th>Status</th><th>Profile</th><th>Security</th><th>Activity</th><th></th></tr></thead>
          <tbody>
            <% for (const account of users) { %>
              <tr>
                <td><%- await obfuscateEmail(account.email) %><br><span class="fineprint">Joined <%= new Date(Number(account.created_at)).toISOString() %></span></td>
                <td><span class="status-badge"><%= account.staff_role === 'none' ? 'user' : account.staff_role %></span></td>
                <td>
                  <%= account.signup_status %><br><span class="fineprint"><%= account.email_verified_at ? 'Email verified' : 'Email unverified' %></span>
                  <% if (account.deletion_status) { %>
                    <br><span class="status-badge status-deleting"><%= account.deletion_status === 'held' ? 'deletion held' : 'queued for deletion' %></span>
                    <br><span class="fineprint">Purge <%= new Date(Number(account.deletion_purge_after)).toISOString() %></span>
                  <% } %>
                </td>
                <td><% if (account.profile_username) { %><strong><%= account.profile_display_name %></strong><br>@<%= account.profile_username %><% } else { %>No profile<% } %><br><span class="fineprint"><%= account.profile_count %> of <%= account.profile_limit || defaultProfileLimit %><% if (account.profile_limit) { %> (override)<% } %></span></td>
                <td><%= account.twofa_method %> 2FA<br><span class="fineprint"><%= account.active_sessions %> active session<%= Number(account.active_sessions) === 1 ? '' : 's' %></span></td>
                <td><span class="fineprint">Updated <%= new Date(Number(account.updated_at)).toISOString() %></span></td>
                <td><a href="/admin/accounts/<%= account.id %>">Open</a></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
    <% if (totalPages > 1) { %>
      <nav class="pagination" aria-label="User directory pages">
        <% if (page > 1) { %><a class="button secondary compact" href="/admin/users?page=<%= page - 1 %>">Previous</a><% } %>
        <span>Page <%= page %> of <%= totalPages %></span>
        <% if (page < totalPages) { %><a class="button secondary compact" href="/admin/users?page=<%= page + 1 %>">Next</a><% } %>
      </nav>
    <% } %>
    <p><a href="/admin">Back to administration</a></p>
  </main>
  <%- await include('../partials/site-footer') %>
</body>
</html>
