<!DOCTYPE html>
<html lang="en">
<head><%- await include('../partials/head', { title }) %></head>
<body>
  <%- await include('../partials/site-header') %>
  <main class="container">
    <p class="eyebrow">Account security</p>
    <h1>Reset your password</h1>
    <p>Enter the verified email address for the account. If it is eligible, an email will contain a reset link and verification code.</p>
    <% if (error) { %><p role="alert" class="error"><%= error %></p><% } %>
    <form method="post" action="/forgot-password">
      <p><label for="email">Email</label><br>
        <input id="email" name="email" type="email" autocomplete="email" required></p>
      <%- await include('../partials/altcha-field', { altchaEndpoint: 'forgot_password' }) %>
      <button type="submit">Send reset instructions</button>
    </form>
    <p><a href="/login">Return to sign in</a></p>
  </main>
  <%- await include('../partials/site-footer') %>
</body>
</html>
