<!DOCTYPE html>
<html lang="en">
<head><%- await include('../partials/head', { title }) %></head>
<body>
  <%- await include('../partials/site-header') %>
  <main class="container">
    <p class="eyebrow">Required before you continue</p>
    <h1>Choose a new password</h1>
    <p>An Administrator required every account to set a new password. The rest of the site stays closed to you until this is done.</p>
    <% if (reason) { %>
      <section class="panel">
        <h2>Reason given</h2>
        <p><%= reason %></p>
      </section>
    <% } %>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <form method="post" action="/account/password-reset-required" class="stack" data-common-password-check>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Current password
        <input type="password" name="current_password" autocomplete="current-password" required placeholder="The password you just signed in with">
      </label>
      <label>New password
        <input type="password" name="password" minlength="12" maxlength="256" autocomplete="new-password" required placeholder="At least 12 characters with an uppercase letter, a lowercase letter, a number, and a symbol, and not a known leaked password">
      </label>
      <p class="error" role="alert" data-common-password-message></p>
      <label>Confirm new password
        <input type="password" name="confirm_password" minlength="12" maxlength="256" autocomplete="new-password" required placeholder="Repeat the new password">
      </label>
      <p class="muted">Common-password screening uses lists from <a href="https://github.com/danielmiessler/SecLists" rel="noreferrer">SecLists</a>. Thank you to its maintainers and contributors.</p>
      <button type="submit">Set new password and sign out other sessions</button>
    </form>
    <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="secondary">Sign out instead</button></form>
  </main>
  <%- await include('../partials/site-footer') %>
  <script src="/static/js/common-password.js"></script>
</body>
</html>
