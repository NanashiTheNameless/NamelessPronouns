<!DOCTYPE html>
<html lang="en">
<head><%- await include('../partials/head', { title }) %></head>
<body>
  <%- await include('../partials/site-header') %>
  <main class="container">
    <p class="eyebrow">Email plus second factor</p>
    <h1>Choose a new password</h1>
    <% if (method === 'email') { %>
      <p>Enter both distinct six-digit codes from the reset email.</p>
    <% } else { %>
      <p>Enter the email verification code and a current authenticator code. An unused recovery code may replace the authenticator code.</p>
    <% } %>
    <% if (error) { %><p role="alert" class="error"><%= error %></p><% } %>
    <form method="post" action="/forgot-password/<%= token %>" data-common-password-check>
      <p><label for="email_code">Email verification code</label><br>
        <input id="email_code" name="email_code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" data-invalid-message="Enter the 6-digit code, digits only." required placeholder="The 6-digit code emailed to you"></p>
      <p><label for="second_factor"><%= method === 'email' ? 'Email two-factor code' : 'Authenticator or recovery code' %></label><br>
        <input id="second_factor" name="second_factor" autocomplete="one-time-code" required placeholder="Your 6-digit app code, or one recovery code"></p>
      <p><label for="password">New password (12 to 256 characters, with an uppercase letter, a lowercase letter, a number, and a symbol)</label><br>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="256" required placeholder="At least 12 characters"></p>
      <p class="error" role="alert" data-common-password-message></p>
      <p><label for="confirm_password">Confirm new password</label><br>
        <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="12" maxlength="256" required placeholder="Repeat the new password"></p>
      <button type="submit">Reset password and sign out sessions</button>
    </form>
  </main>
  <%- await include('../partials/site-footer') %>
  <script src="/static/js/common-password.js"></script>
</body>
</html>
