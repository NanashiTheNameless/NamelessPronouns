NODE_ENV=production
BASE_URL=https://pronouns.example.com
PORT=3000

# Distinct, cryptographically random secrets. Minimum 32 bytes each.
COOKIE_SECRET=replace-with-unique-cookie-secret
POLICY_COOKIE_SECRET=replace-with-unique-policy-cookie-secret
TOKEN_HASH_KEY=replace-with-unique-token-hash-key
ALTCHA_HMAC_KEY=replace-with-unique-altcha-hmac-key
# Proof-of-work search ceiling. NamelessUnSee-compatible production default.
ALTCHA_MAX_NUMBER=400000
# Optional separate password pepper. Leave empty to disable explicitly.
PASSWORD_PEPPER=replace-with-unique-password-pepper
# base64-encoded 32-byte keys.
TOTP_ENCRYPTION_KEY=replace-with-unique-totp-encryption-key
CONTENT_FLAG_ENCRYPTION_KEY=replace-with-unique-content-flag-encryption-key
# Optional: encrypts ban email/IP/CIDR targets at rest. Matching works without
# it via keyed lookup hashes; set it to enable encrypted display of targets.
BAN_ENCRYPTION_KEY=replace-with-unique-ban-encryption-key
# Required only by the backup and restore commands. Keep this base64-encoded
# 32-byte key outside the database host and preserve it for the full retention
# lifetime of every encrypted backup.
BACKUP_ENCRYPTION_KEY=replace-with-unique-backup-encryption-key

# Development only: log (do not send) outbound mail when true.
MAIL_DEV_LOG=false

SECURE_COOKIES=true

# Select exactly one database backend: postgres | d1
DB_BACKEND=d1
# Used by docker-compose.dev.yml when its app service selects PostgreSQL.
POSTGRES_PASSWORD=replace-with-unique-postgres-password
DATABASE_URL=postgres://namelesspronouns:replace-with-unique-postgres-password@postgres:5432/namelesspronouns

# Cloudflare D1, used by the default docker-compose.yml.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_D1_DATABASE_ID=replace-with-cloudflare-d1-database-id
CLOUDFLARE_D1_API_TOKEN=replace-with-cloudflare-d1-api-token

RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM=NamelessPronouns <accounts@example.com>
ADMIN_NOTIFY_TO=Nanashi <Nanashi@NamelessNanashi.dev>
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

DISPOSABLE_EMAIL_DOMAINS=example-tempmail.invalid,example-relay.invalid
DISPOSABLE_LIST_ENABLED=true
DISPOSABLE_LIST_URL=
DISPOSABLE_REFRESH_HOURS=24
EMAIL_DOMAIN_ALLOWLIST_ENABLED=false
# Optional override for the built-in mainstream-provider allowlist.
# EMAIL_DOMAIN_ALLOWLIST=example.com,gmail.com,icloud.com

CONTENT_RULES_SEED_PATH=/app/config/content-rules.json
CONTENT_WARNING_THRESHOLD=3
CONTENT_WARNING_WINDOW_HOURS=24
