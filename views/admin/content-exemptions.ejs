<!DOCTYPE html>
<html lang="en">
<head><%- await include('../partials/head', { title }) %></head>
<body>
  <%- await include('../partials/site-header') %>
  <main class="container">
    <p class="eyebrow">Administrator tools</p>
    <h1>Content exemptions</h1>
    <p><a class="button" href="/admin/content-exemptions/new">Create exemption</a></p>
    <% if (exemptions.length === 0) { %><p>No active exemptions.</p><% } %>
    <% for (const item of exemptions) { %>
      <section class="panel stack">
        <h2><%= item.rule_id ? `${item.rule_id}, version ${item.version}` : 'All content rules' %></h2>
        <p>Field <%= item.field_type ? contentFieldLabel(item.field_type) : 'all fields' %>; account <% if (item.email) { %><%- await obfuscateEmail(item.email) %><% } else { %>all accounts<% } %>; profile scope <%= item.profile_id || 'all account profiles' %>; <%= item.self_exemption ? 'self exemption' : 'staff exemption' %>.</p>
        <p>Value:
          <% if (item.accountWide) { %>every value on the account<%
             } else if (item.legacyHashed) { %>stored as a hash by an older version and not displayable<%
             } else { %><code><%- await obfuscateEmails(item.normalized_value) %></code><% } %>
        </p>
        <p>Created <%= item.createdAt %>. <% if (item.updatedAt) { %>Edited <%= item.updatedAt %>. <% } %>Expires <%= item.expiresAt || 'never' %>.</p>
        <p><a href="/admin/content-exemptions/<%= item.id %>/edit">Edit this exemption</a></p>
        <form method="post" action="/admin/content-exemptions/<%= item.id %>" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>New expiry
            <select name="expiry"><option value="7">7 days from now</option><option value="30">30 days</option><option value="90">90 days</option><option value="none">No expiry</option></select>
          </label>
          <label>Reason <input name="reason" maxlength="200" required placeholder="Why this exemption applies"></label>
          <label>Type UPDATE EXEMPTION <input name="confirmation" autocomplete="off" required placeholder="UPDATE EXEMPTION"></label>
          <button type="submit" name="action" value="expiry">Update expiry</button>
        </form>
        <form method="post" action="/admin/content-exemptions/<%= item.id %>" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Revocation reason <input name="reason" maxlength="200" required placeholder="Why this exemption applies"></label>
          <label>Type REVOKE EXEMPTION <input name="confirmation" autocomplete="off" required placeholder="REVOKE EXEMPTION"></label>
          <button type="submit" name="action" value="revoke" class="danger">Revoke exemption</button>
        </form>
      </section>
    <% } %>
    <p><a href="/admin/content-rules">Back to content rules</a></p>
  </main>
  <%- await include('../partials/site-footer') %>
</body>
</html>
