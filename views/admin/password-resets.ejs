<!DOCTYPE html>
<html lang="en">
<head><%- await include('../partials/head', { title }) %></head>
<body>
  <%- await include('../partials/site-header') %>
  <main class="container">
    <p class="eyebrow">Administrator tools</p>
    <h1>Forced password resets</h1>
    <p>Requiring a reset signs out every session on the site and flags every approved account. Each account still signs in with its current password, then must choose a new one before reaching any other page. Everyone is emailed the reason.</p>
    <p><strong>This signs you out too.</strong> Your own account is flagged like everyone else, so you will sign in again and set a new password before returning here.</p>
    <p><%= outstanding %> account<%= outstanding === 1 ? '' : 's' %> still owe a new password.</p>
    <section>
      <h2>Require a reset for every account</h2>
      <form method="post" action="/admin/password-resets" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Reason <textarea name="reason" required placeholder="Why every account must choose a new password"></textarea></label>
        <label>Type FORCE PASSWORD RESET <input name="confirmation" autocomplete="off" required placeholder="FORCE PASSWORD RESET"></label>
        <button type="submit">Require a new password everywhere</button>
      </form>
    </section>
    <section>
      <h2>Recent mandates</h2>
      <% if (!mandates.length) { %>
        <p>No account-wide password reset has ever been required.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Required</th><th>Reason</th><th>Accounts</th><th>Signed out</th><th>Notified</th><th>Failed</th></tr></thead>
          <tbody>
          <% for (const m of mandates) { %>
            <tr>
              <td><%= new Date(Number(m.created_at)).toISOString() %></td>
              <td><%- await obfuscateEmails(m.reason || '') %></td>
              <td><%= m.accounts %></td>
              <td><%= m.sessions_revoked %></td>
              <td><%= m.completed_at ? m.notified : 'sending' %></td>
              <td><%= m.completed_at ? m.notify_failed : '' %></td>
            </tr>
          <% } %>
          </tbody>
        </table>
      <% } %>
    </section>
    <p><a href="/admin">Back to administration</a></p>
  </main>
  <%- await include('../partials/site-footer') %>
</body>
</html>
