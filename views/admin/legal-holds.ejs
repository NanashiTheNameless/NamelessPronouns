<!DOCTYPE html>
<html lang="en"><head><%- await include('../partials/head', { title }) %></head><body>
  <%- await include('../partials/site-header') %><main class="container">
    <p class="eyebrow">Administrator tools</p><h1>Legal holds</h1>
    <p>Use only for a documented preservation duty. Scope narrowly and review on schedule.</p>
    <form method="post" action="/admin/legal-holds" class="panel stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Exact account email <input type="email" name="email" maxlength="254" required></label>
      <label>Narrow scope <input name="scope" maxlength="100" required></label>
      <label>Documented reason category <input name="reason" maxlength="200" required></label>
      <label>Review interval <select name="review_days"><option value="30">30 days</option><option value="90">90 days</option><option value="365">365 days</option></select></label>
      <label>Type CREATE LEGAL HOLD <input name="confirmation" autocomplete="off" required></label>
      <button type="submit">Create legal hold</button>
    </form>
    <% if (holds.length === 0) { %><p>No active legal holds.</p><% } %>
    <% for (const hold of holds) { %>
      <section class="panel stack"><h2><%- await obfuscateEmail(hold.email) %></h2>
        <p>Scope: <%= hold.scope %>. Reason: <%- await obfuscateEmails(hold.reason) %>. Started <%= hold.startedAt %>; review <%= hold.reviewAt %>.</p>
        <form method="post" action="/admin/legal-holds/<%= hold.id %>/release" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Release reason <input name="reason" maxlength="200" required></label>
          <label>Type RELEASE LEGAL HOLD <input name="confirmation" autocomplete="off" required></label>
          <button type="submit" class="danger">Release hold</button>
        </form>
      </section>
    <% } %>
    <p><a href="/admin">Back to administration</a></p>
  </main><%- await include('../partials/site-footer') %></body></html>
